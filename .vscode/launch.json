// Launch configurations for compiling and testing the extension.
// Use IntelliSense to learn about possible attributes.
// Hover to view descriptions of existing attributes.
// For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "VSCode - Run Extension (Isolated)",
      "type": "node-terminal",
      "request": "launch",
      "command": "bun run extension:isolated --wait",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "VSCode - Compile Extension",
      "type": "node-terminal",
      "request": "launch",
      "command": "bun run --cwd packages/kilo-vscode compile",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "VSCode - Build VSIX",
      "type": "node-terminal",
      "request": "launch",
      "command": "bun run package:vsix --single",
      "cwd": "${workspaceFolder}/packages/kilo-vscode"
    },
    {
      "name": "VSCode - Run Extension",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--disable-extensions",
        "--extensionDevelopmentPath=${workspaceFolder}/packages/kilo-vscode",
        "${workspaceFolder}"
      ],
      "outFiles": ["${workspaceFolder}/packages/kilo-vscode/dist/**/*.js"],
      "preLaunchTask": "VSCode - Compile"
    },
    {
      "name": "VSCode - Run Extension (Local Backend)",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--disable-extensions",
        "--extensionDevelopmentPath=${workspaceFolder}/packages/kilo-vscode",
        "${workspaceFolder}"
      ],
      "outFiles": ["${workspaceFolder}/packages/kilo-vscode/dist/**/*.js"],
      "preLaunchTask": "VSCode - Compile",
      "env": {
        "KILO_API_URL": "http://localhost:3000"
      }
    },
    {
      "name": "VSCode - Run Extension (Isolated Clean)",
      "type": "node-terminal",
      "request": "launch",
      "command": "bun script/launch.ts --isolated --clean --workspace \"${workspaceFolder}\"",
      "cwd": "${workspaceFolder}/packages/kilo-vscode"
    }
  ]
}
