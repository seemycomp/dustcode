#!/bin/sh
set -e

bun -e '
import { semver } from "bun"
const pkg = await Bun.file("package.json").json()
const expectedBunVersion = pkg.packageManager?.split("@")[1]
if (!expectedBunVersion) throw Error("packageManager field not found in root package.json")
const expectedBunVersionRange = `^${expectedBunVersion}`
if (!semver.satisfies(process.versions.bun, expectedBunVersionRange)) {
  throw Error(`This script requires bun@${expectedBunVersionRange}, but you are using bun@${process.versions.bun}`)
}
if (process.versions.bun !== expectedBunVersion) {
  console.warn(`Warning: Bun version ${process.versions.bun} differs from expected ${expectedBunVersion}`)
}
'

# kilocode_change start
# In a linked worktree, Git exports GIT_DIR without GIT_WORK_TREE. Turbo runs
# git status inside packages, which then become the worktree root and make files
# appear deleted. Unset these variables so Git finds the repository from cwd.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE
bun run typecheck:vscode
# kilocode_change end
