        "category": "Dustcode"
      },
      {
        "command": "dustcode.agentManager.diagnostics",
        "title": "Agent Manager: Show Worktree Diagnostics",
        "category": "Dustcode"
      },
      {
        "command": "dustcode.agentManager.search",
        "title": "Agent Manager: Search Worktrees and Sessions",
        "category": "Dustcode"
      },
      {
        "command": "dustcode.agentManager.showTerminal",
        "title": "Agent Manager: Focus Terminal",
        "category": "Dustcode",
        "icon": "$(terminal)"
      },
      {
        "command": "dustcode.agentManager.runScript",
        "title": "Agent Manager: Run Script",
        "category": "Dustcode",
        "icon": "$(play)"
      },
      {
        "command": "dustcode.agentManager.toggleDiff",
