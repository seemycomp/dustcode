{
  "name": "dustcode",
  "displayName": "Dustcode",
  "description": "Open Source AI coding agent that generates code from natural language, automates tasks, and runs terminal commands. Features inline autocomplete, browser automation, automated refactoring, and custom modes for planning, coding, and debugging. Supports 500+ AI models including Claude (Anthropic), Gemini, Grok, GPT, Codex and GLM.",
  "version": "7.8.17",
  "icon": "assets/icons/dustcode.png",
  "galleryBanner": {
    "color": "#FFFFFF",
    "theme": "light"
  },
  "publisher": "dustcode",
  "repository": {
    "type": "git",
    "url": "https://github.com/seemycomp/dustcode.git",
    "directory": "packages/kilo-vscode"
  },
  "engines": {
    "vscode": "^1.105.1"
  },
  "license": "MIT",
  "author": {
    "name": "Dustcode"
  },
  "categories": [
    "AI",
    "Chat",
    "Programming Languages",
    "Education",
    "Snippets",
    "Testing"
  ],
  "keywords": [
    "dustcode",
    "ai",
    "agent",
    "agentic",
    "coding",
    "coding agent",
    "coding assistant",
    "autocomplete",
    "code completion",
    "pair programming",
    "chat",
    "terminal",
    "chatgpt",
    "claude",
    "sonnet",
    "anthropic",
    "openai",
    "zoo code",
    "opencode",
    "open code"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onUri"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "configurationDefaults": {
      "files.watcherExclude": {
        "**/.dustcode/worktrees/**": true
      }
    },
    "taskDefinitions": [
      {
        "type": "dustcode-worktree-setup",
        "properties": {
          "script": {
            "type": "string",
            "description": "The setup script command to execute"
          },
          "worktree": {
            "type": "string",
            "description": "The worktree directory the setup script runs in"
          }
        }
      }
    ],
    "icons": {
      "dustcode-logo": {
        "description": "Dustcode logo",
        "default": "code"
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "dustcode-ActivityBar",
          "title": "Dustcode",
          "icon": "assets/icons/dustcode.png"
        }
      ]
    },
    "views": {
      "dustcode-ActivityBar": [
        {
          "type": "webview",
          "id": "dustcode.SidebarProvider",
          "name": "Dustcode"
        }
      ]
    },
    "commands": [
      {
        "command": "dustcode.plusButtonClicked",
        "title": "New Task",
        "category": "Dustcode",
        "icon": "$(add)"
      },
      {
        "command": "dustcode.closeTask",
        "title": "Close Task",
        "category": "Dustcode"
      },
      {
        "command": "dustcode.closeAllTasks",
        "title": "Close All Tasks",
        "category": "Dustcode"
      },
      {
        "command": "dustcode.agentManagerOpen",
        "title": "Agent Manager",
        "category": "Dustcode",
        "icon": "$(organization)"
      },
      {
        "command": "dustcode.marketplaceButtonClicked",
        "title": "Marketplace",
        "category": "Dustcode",
        "icon": "$(extensions)"
      },
      {
        "command": "dustcode.historyButtonClicked",
        "title": "History",
        "category": "Dustcode",
        "icon": "$(history)"
      },
      {
        "command": "dustcode.profileButtonClicked",
        "title": "Profile",
        "category": "Dustcode",
        "icon": "$(account)"
      },
      {
        "command": "dustcode.settingsButtonClicked",
        "title": "Settings",
        "category": "Dustcode",
        "icon": "$(settings-gear)"
      },
      {
        "command": "dustcode.settingsSearch",
        "title": "Search Settings",
        "category": "Dustcode",
        "icon": "$(search)"
      },
      {
        "command": "dustcode.sidebarTitle.plusButtonClicked",
        "title": "New Task",
        "icon": "$(add)"
      },
      {
        "command": "dustcode.sidebarTitle.agentManagerOpen",
        "title": "Agent Manager",
