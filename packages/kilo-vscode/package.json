    "submenus": [
      {
        "id": "dustcode.editorContextMenu",
        "label": "Dustcode"
      },
      {
        "id": "dustcode.terminalContextMenu",
        "label": "Dustcode"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "dustcode.sidebarTitle.plusButtonClicked",
          "when": "false"
        },
        {
          "command": "dustcode.sidebarTitle.historyButtonClicked",
          "when": "false"
        },
        {
          "command": "dustcode.sidebarTitle.agentManagerOpen",
          "when": "false"
        },
        {
          "command": "dustcode.agentManager.advancedWorktree",
          "when": "false"
        },
        {
          "command": "dustcode.sidebarTitle.marketplaceButtonClicked",
          "when": "false"
        },
        {
          "command": "dustcode.sidebarTitle.profileButtonClicked",
          "when": "false"
        },
        {
          "command": "dustcode.sidebarTitle.settingsButtonClicked",
          "when": "false"
        },
        {
          "command": "dustcode.renameSession",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "dustcode.sidebarTitle.plusButtonClicked",
          "group": "navigation@0",
          "when": "view == dustcode.SidebarProvider && !dustcode.isCursor"
        },
        {
          "command": "dustcode.sidebarTitle.historyButtonClicked",
          "group": "navigation@1",
          "when": "view == dustcode.SidebarProvider && !dustcode.isCursor"
        },
        {
          "command": "dustcode.sidebarTitle.agentManagerOpen",
          "group": "navigation@2",
          "when": "view == dustcode.SidebarProvider && !dustcode.isCursor"
        },
        {
          "command": "dustcode.sidebarTitle.marketplaceButtonClicked",
          "group": "navigation@3",
          "when": "view == dustcode.SidebarProvider && !dustcode.isCursor"
        },
        {
          "command": "dustcode.sidebarTitle.profileButtonClicked",
          "group": "navigation@4",
          "when": "view == dustcode.SidebarProvider && !dustcode.isCursor"
        },
        {
          "command": "dustcode.sidebarTitle.settingsButtonClicked",
          "group": "navigation@5",
          "when": "view == dustcode.SidebarProvider && !dustcode.isCursor"
        }
      ],
      "scm/title": [
        {
          "command": "dustcode.generateCommitMessage",
          "group": "navigation",
          "when": "scmProvider == git"
        }
      ],
      "scm/input": [
        {
          "command": "dustcode.generateCommitMessage",
          "group": "navigation",
          "when": "scmProvider == git"
        }
      ],
      "editor/title": [
        {
          "command": "dustcode.openInTab",
          "group": "navigation",
          "when": "true"
        },
        {
          "command": "dustcode.plusButtonClicked",
          "group": "navigation@0",
          "when": "activeWebviewPanelId == dustcode.TabPanel && !dustcode.isCursor"
        },
        {
          "command": "dustcode.historyButtonClicked",
          "group": "navigation@1",
          "when": "activeWebviewPanelId == dustcode.TabPanel && !dustcode.isCursor"
        },
        {
          "command": "dustcode.profileButtonClicked",
          "group": "navigation@2",
          "when": "activeWebviewPanelId == dustcode.TabPanel && !dustcode.isCursor"
        },
        {
          "command": "dustcode.settingsButtonClicked",
          "group": "navigation@3",
          "when": "activeWebviewPanelId == dustcode.TabPanel && !dustcode.isCursor"
        }
      ],
      "editor/context": [
        {
          "submenu": "dustcode.editorContextMenu",
          "group": "1_dustcode"
        }
      ],
      "editor/title/context": [
        {
          "command": "dustcode.renameSession",
          "group": "navigation@0",
          "when": "resourceScheme == webview-panel && resourcePath =~ /webview-panel\\/webview-/"
        }
      ],
      "dustcode.editorContextMenu": [
        {
          "command": "dustcode.explainCode",
          "group": "1_actions@1"
        },
        {
          "command": "dustcode.fixCode",
          "group": "1_actions@2"
        },
        {
          "command": "dustcode.improveCode",
          "group": "1_actions@3"
        },
        {
          "command": "dustcode.addToContext",
          "group": "1_actions@4"
        }
      ],
      "terminal/context": [
        {
          "submenu": "dustcode.terminalContextMenu",
          "group": "2_dustcode"
        }
      ],
      "dustcode.terminalContextMenu": [
        {
          "command": "dustcode.terminalAddToContext",
          "group": "1_actions@1"
        },
        {
          "command": "dustcode.terminalFixCommand",
          "group": "1_actions@2"
        },
        {
          "command": "dustcode.terminalExplainCommand",
          "group": "1_actions@3"
        }
      ]
    },
    "keybindings": [
      {
        "command": "dustcode.agentManager.previousSession",
        "key": "ctrl+alt+up",
        "mac": "cmd+alt+up",
        "when": "activeWebviewPanelId == 'dustcode.AgentManagerPanel'"
      },
      {
        "command": "dustcode.agentManager.nextSession",
        "key": "ctrl+alt+down",
        "mac": "cmd+alt+down",
        "when": "activeWebviewPanelId == 'dustcode.AgentManagerPanel'"
      },
      {
        "command": "dustcode.agentManager.previousTab",
        "key": "ctrl+alt+left",
        "mac": "cmd+alt+left",
        "when": "dustcode.sidebarFocused || activeWebviewPanelId == 'dustcode.TabPanel' || activeWebviewPanelId == 'dustcode.AgentManagerPanel'"
      },
      {
        "command": "dustcode.agentManager.nextTab",
        "key": "ctrl+alt+right",
        "mac": "cmd+alt+right",
        "when": "dustcode.sidebarFocused || activeWebviewPanelId == 'dustcode.TabPanel' || activeWebviewPanelId == 'dustcode.AgentManagerPanel'"
      },
      {
        "command": "dustcode.agentManager.previousTerminal",
        "key": "ctrl+shift+[",
        "mac": "cmd+shift+[",
        "when": "activeWebviewPanelId == 'dustcode.AgentManagerPanel'"
      },
      {
        "command": "dustcode.agentManager.nextTerminal",
        "key": "ctrl+shift+]",
        "mac": "cmd+shift+]",
        "when": "activeWebviewPanelId == 'dustcode.AgentManagerPanel'"
      },
      {
        "command": "dustcode.agentManager.search",
        "key": "ctrl+f",
        "mac": "cmd+f",
        "when": "activeWebviewPanelId == 'dustcode.AgentManagerPanel' && !terminalFocus"
      },
      {
        "command": "dustcode.agentManager.showTerminal",
        "key": "ctrl+/",
        "mac": "cmd+/",
        "when": "activeWebviewPanelId == 'dustcode.AgentManagerPanel' && !dustcode.sidebarFocused"
      },
      {
        "command": "dustcode.agentManager.runScript",
        "key": "ctrl+e",
        "mac": "cmd+e",
        "when": "activeWebviewPanelId == 'dustcode.AgentManagerPanel' && (isMac || !terminalFocus)"
      },
      {
        "command": "dustcode.agentManager.toggleDiff",
        "key": "ctrl+d",
        "mac": "cmd+d",
        "when": "activeWebviewPanelId == 'dustcode.AgentManagerPanel'"
      },
      {
        "command": "dustcode.agentManager.showShortcuts",
        "key": "ctrl+shift+/",
        "mac": "cmd+shift+/",
        "when": "activeWebviewPanelId == 'dustcode.AgentManagerPanel'"
      },
      {
        "command": "dustcode.agentManager.newTab",
        "key": "ctrl+t",
        "mac": "cmd+t",
        "when": "activeWebviewPanelId == 'dustcode.AgentManagerPanel' && !dustcode.agentManagerSideTerminalFocused"
      },
      {
        "command": "dustcode.agentManager.newTerminalTab",
        "key": "ctrl+shift+t",
        "mac": "cmd+shift+t",
        "when": "activeWebviewPanelId == 'dustcode.AgentManagerPanel' && !dustcode.agentManagerSideTerminalFocused"
      },
      {
        "command": "dustcode.agentManager.newSideTerminal",
        "key": "ctrl+t",
        "mac": "cmd+t",
        "when": "activeWebviewPanelId == 'dustcode.AgentManagerPanel' && dustcode.agentManagerSideTerminalFocused"
      },
      {
        "command": "dustcode.agentManager.closeTab",
        "key": "ctrl+w",
        "mac": "cmd+w",
        "when": "activeWebviewPanelId == 'dustcode.AgentManagerPanel'"
      },
      {
        "command": "dustcode.agentManager.newWorktree",
        "key": "ctrl+n",
        "mac": "cmd+n",
        "when": "activeWebviewPanelId == 'dustcode.AgentManagerPanel'"
      },
      {
        "command": "dustcode.agentManager.quickWorktree",
        "key": "ctrl+shift+n",
        "mac": "cmd+shift+n",
        "when": "activeWebviewPanelId == 'dustcode.AgentManagerPanel'"
      },
      {
        "command": "dustcode.agentManager.openWorktree",
        "key": "ctrl+shift+o",
        "mac": "cmd+shift+o",
        "when": "activeWebviewPanelId == 'dustcode.AgentManagerPanel'"
      },
      {
        "command": "dustcode.agentManager.openPR",
        "key": "ctrl+shift+r",
        "mac": "cmd+shift+r",
        "when": "activeWebviewPanelId == 'dustcode.AgentManagerPanel'"
      },
      {
        "command": "dustcode.agentManager.closeWorktree",
        "key": "ctrl+shift+w",
        "mac": "cmd+shift+w",
        "when": "activeWebviewPanelId == 'dustcode.AgentManagerPanel'"
      },
      {
        "command": "dustcode.agentManager.jumpTo1",
        "key": "ctrl+1",
        "mac": "cmd+1",
        "when": "activeWebviewPanelId == 'dustcode.AgentManagerPanel'"
      },
      {
        "command": "dustcode.agentManager.jumpTo2",
        "key": "ctrl+2",
        "mac": "cmd+2",
        "when": "activeWebviewPanelId == 'dustcode.AgentManagerPanel'"
      },
      {
        "command": "dustcode.agentManager.jumpTo3",
        "key": "ctrl+3",
        "mac": "cmd+3",
        "when": "activeWebviewPanelId == 'dustcode.AgentManagerPanel'"
      },
      {
        "command": "dustcode.agentManager.jumpTo4",
        "key": "ctrl+4",
        "mac": "cmd+4",
        "when": "activeWebviewPanelId == 'dustcode.AgentManagerPanel'"
      },
      {
        "command": "dustcode.agentManager.jumpTo5",
        "key": "ctrl+5",
        "mac": "cmd+5",
        "when": "activeWebviewPanelId == 'dustcode.AgentManagerPanel'"
      },
      {
        "command": "dustcode.agentManager.jumpTo6",
        "key": "ctrl+6",
        "mac": "cmd+6",
        "when": "activeWebviewPanelId == 'dustcode.AgentManagerPanel'"
      },
      {
        "command": "dustcode.agentManager.jumpTo7",
        "key": "ctrl+7",
        "mac": "cmd+7",
        "when": "activeWebviewPanelId == 'dustcode.AgentManagerPanel'"
      },
      {
        "command": "dustcode.agentManager.jumpTo8",
        "key": "ctrl+8",
        "mac": "cmd+8",
        "when": "activeWebviewPanelId == 'dustcode.AgentManagerPanel'"
      },
      {
        "command": "dustcode.agentManager.jumpTo9",
        "key": "ctrl+9",
        "mac": "cmd+9",
        "when": "activeWebviewPanelId == 'dustcode.AgentManagerPanel'"
      },
      {
        "command": "dustcode.cycleAgentMode",
        "key": "ctrl+.",
        "mac": "cmd+.",
        "when": "dustcode.sidebarFocused || activeWebviewPanelId == 'dustcode.AgentManagerPanel' || activeWebviewPanelId == 'dustcode.TabPanel'"
      },
      {
        "command": "dustcode.cyclePreviousAgentMode",
        "key": "ctrl+shift+.",
        "mac": "cmd+shift+.",
        "when": "dustcode.sidebarFocused || activeWebviewPanelId == 'dustcode.AgentManagerPanel' || activeWebviewPanelId == 'dustcode.TabPanel'"
      },
      {
        "command": "dustcode.autocomplete.cancelSuggestions",
        "key": "escape",
        "when": "editorTextFocus && !editorTabMovesFocus && !inSnippetMode && dustcode.autocomplete.hasSuggestions"
      },
      {
        "command": "dustcode.autocomplete.generateSuggestions",
        "key": "ctrl+l",
        "mac": "cmd+l",
        "when": "editorTextFocus && !editorTabMovesFocus && !inSnippetMode && dustcode.autocomplete.enableSmartInlineTaskKeybinding && !github.copilot.completions.enabled"
      },
      {
        "command": "dustcode.autocomplete.showIncompatibilityExtensionPopup",
        "key": "ctrl+l",
        "mac": "cmd+l",
        "when": "editorTextFocus && !editorTabMovesFocus && !inSnippetMode && dustcode.autocomplete.enableSmartInlineTaskKeybinding && github.copilot.completions.enabled"
      },
      {
        "command": "dustcode.autocomplete.nextEdit.acceptOrJump",
        "key": "tab",
        "when": "editorTextFocus && !editorTabMovesFocus && !inSnippetMode && !suggestWidgetVisible && dustcode.nextEdit.hasPendingSuggestion"
      },
      {
        "command": "dustcode.autocomplete.nextEdit.dismiss",
        "key": "escape",
        "when": "editorTextFocus && !editorTabMovesFocus && !inSnippetMode && dustcode.nextEdit.hasPendingSuggestion"
      },
      {
        "command": "dustcode.settingsSearch",
        "key": "ctrl+f",
        "mac": "cmd+f",
        "when": "activeWebviewPanelId == 'dustcode.settingsPanel'"
      }
    ],
