        "category": "Dustcode",
        "icon": "$(diff)"
      },
      {
        "command": "dustcode.agentManager.showShortcuts",
        "title": "Agent Manager: Show Keyboard Shortcuts",
        "category": "Dustcode",
        "icon": "$(keyboard)"
      },
      {
        "command": "dustcode.agentManager.newTab",
